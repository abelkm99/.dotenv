# Config generated by Ghostty Config

background-opacity= 1
clipboard-read = allow
clipboard-write = deny
theme = Monokai Pro Ristretto

copy-on-select = clipboard
bold-is-bright = true
mouse-hide-while-typing = true
mouse-scroll-multiplier = 5.2
# macos-non-native-fullscreen = false
macos-option-as-alt = true
keybind = super+j=text:\u{B1}
keybind = super+k=text:\u{B2}
keybind = super+l=text:\u{B3}
keybind = super+h=text:\u{B5}
keybind = ctrl+j=text:\u{B1}
keybind = ctrl+k=text:\u{B2}
keybind = ctrl+l=text:\u{B3}
keybind = ctrl+h=text:\u{B5}
 
# keybind = »=goto_split:top
# keybind = ½=goto_split:bottom
# keybind  = ¼=goto_split:right
# keybind = ¾=goto_split:left

keybind = super+i=new_split:right
keybind = super+o=new_split:down
keybind = ctrl+i=new_split:right
keybind = ctrl+o=new_split:down

# New tab
keybind = ctrl+n=new_tab
keybind = ctrl+t=new_tab

# Close current tab
keybind = ctrl+w=close_surface

# Go to tab 1-9
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9
